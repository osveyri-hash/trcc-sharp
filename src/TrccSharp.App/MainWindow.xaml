<Window x:Class="TrccSharp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TrccSharp.App"
        xmlns:controls="clr-namespace:TrccSharp.App.Controls"
        Title="TrccSharp — экран СЖО"
        Icon="assets/TrccSharp.ico"
        Height="880" Width="1180" MinHeight="700" MinWidth="1040"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDropFile" DragOver="OnDragOver">

    <Window.Resources>
        <!-- Кисти Ink/Paper/Surface/Grey/Faint/Rule/Wash/Rose приходят из Skins.cs:
             светлая и тёмная темы окна переключаются на лету. -->

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Три полоски: сворачивают подписи левой панели до одних контролов -->
        <Style x:Key="Burger" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="11">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="L1" Width="14" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Ink}" Margin="0,0,0,3" />
                                <Border x:Name="L2" Width="14" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Ink}" Margin="0,0,0,3" />
                                <Border x:Name="L3" Width="14" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Ink}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rose}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                <Setter TargetName="L1" Property="Background" Value="{DynamicResource Paper}" />
                                <Setter TargetName="L2" Property="Background" Value="{DynamicResource Paper}" />
                                <Setter TargetName="L3" Property="Background" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ползунок: мягкая дорожка и круглая ручка -->
        <Style x:Key="InkSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Rule}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Rose}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Ink}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка темы панели: сама плитка прозрачная — заливку рисует
             переезжающее «жидкое стекло», а текст всегда остаётся сверху. -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Height" Value="60" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="14" Opacity="0"
                                    Background="{DynamicResource Wash}"
                                    BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="16,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.55" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подложка плитки: карточка, поверх которой ездит стекло -->
        <Style x:Key="TileShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Вкладка в шапке: пилюля -->
        <Style x:Key="Tab" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="12,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Язык: маленькая пилюля -->
        <Style x:Key="Lang" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель из двух вариантов: заливку рисует LiquidSegments -->
        <Style x:Key="Seg" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="9" Opacity="0"
                                    Background="{DynamicResource Wash}"
                                    BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.5" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кружок акцента: цвет внутри, кольцо вокруг, выбор — жирное кольцо -->
        <Style x:Key="AccentDot" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Rule}" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Margin="4" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Rose}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ink}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Выбор шрифта кадра -->
        <Style x:Key="FontPicker" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="9">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Data="M 0 0 L 8 0 L 4 5 Z"
                                                      Fill="{DynamicResource Grey}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                                        BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" MaxHeight="260"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Wash}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- Имя шрифта набрано им самим: список сразу показывает, как будет выглядеть -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13"
                                   Foreground="{DynamicResource Ink}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-контур -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rose}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка -->
        <Style x:Key="Solid" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Paper}" />
            <Setter Property="Background" Value="{DynamicResource Ink}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле ввода -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rose}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкая полоса прокрутки -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Faint}" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка тем -->
        <Style x:Key="PresetItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="9" Margin="2" Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}" />
                                <Setter Property="Foreground" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: три полоски, название, вкладки, язык -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="CompactToggle" Style="{StaticResource Burger}" Click="OnCompactClick" />
                <TextBlock Text="TrccSharp" FontFamily="Segoe UI Light" FontSize="30" Margin="14,0,0,0"
                           Foreground="{DynamicResource Ink}" />
                <TextBlock Text="画面" FontFamily="Yu Gothic UI" FontSize="15"
                           Foreground="{DynamicResource Rose}" Margin="12,0,0,5" VerticalAlignment="Bottom" />
            </StackPanel>

            <controls:LiquidSegments x:Name="TabSegments" Grid.Column="1" VerticalAlignment="Bottom"
                                     Margin="28,0,0,2"
                                     PillBrush="{DynamicResource Wash}" PillCornerRadius="9">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="TabSettings" Style="{StaticResource Tab}" IsChecked="True"
                                  Tag="settings" Click="OnTabClick"
                                  Content="{Binding [tab.settings], Source={x:Static app:Loc.Instance}}" />
                    <ToggleButton x:Name="TabThemes" Style="{StaticResource Tab}" Tag="themes"
                                  Margin="4,0,0,0" Click="OnTabClick"
                                  Content="{Binding [tab.themes], Source={x:Static app:Loc.Instance}}" />
                </StackPanel>
            </controls:LiquidSegments>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:LiquidSegments x:Name="LangSegments"
                                         PillBrush="{DynamicResource Ink}" PillCornerRadius="7">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LangRu" Style="{StaticResource Lang}" Content="RU" Tag="ru"
                                      Click="OnLangClick" />
                        <ToggleButton x:Name="LangEn" Style="{StaticResource Lang}" Content="EN" Tag="en"
                                      Margin="4,0,0,0" Click="OnLangClick" />
                    </StackPanel>
                </controls:LiquidSegments>
                <TextBlock Text="{Binding [header.screen], Source={x:Static app:Loc.Instance}}"
                           Width="180" TextAlignment="Right"
                           FontSize="10" Foreground="{DynamicResource Grey}"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource Rule}" Margin="0,0,0,14" />

        <!-- Плитки тем панели. Слои снизу вверх: карточки → стекло → подписи →
             кликабельные плитки. Подписи идут в двух цветах: светлые видны вне
             стекла, тёмные — ровно под ним, поэтому надпись читается всегда,
             даже когда стекло проезжает над ней. -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <UniformGrid Rows="1" Columns="3">
                <Border Style="{StaticResource TileShell}" Margin="0,0,10,0" />
                <Border Style="{StaticResource TileShell}" Margin="0,0,10,0" />
                <Border Style="{StaticResource TileShell}" />
            </UniformGrid>

            <!-- Стекло: переезжает к выбранной плитке и на ходу вытягивается -->
            <Canvas x:Name="TileGlassLayer" IsHitTestVisible="False">
                <Border x:Name="TileGlass" Width="0" Height="0" CornerRadius="14"
                        Background="{DynamicResource Ink}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TileGlassScale" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270"
                                          Opacity="0.3" Color="#000000" />
                    </Border.Effect>
                    <Border CornerRadius="13" Margin="1" BorderThickness="1"
                            BorderBrush="{DynamicResource Rose}" Opacity="0.55">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#38FFFFFF" Offset="0" />
                                <GradientStop Color="#00FFFFFF" Offset="0.55" />
                                <GradientStop Color="#14FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Border>
            </Canvas>

            <!-- Тёмные подписи: видны только там, где лежит стекло -->
            <Grid x:Name="TileInvertLayer" IsHitTestVisible="False">
                <Grid.Clip>
                    <RectangleGeometry x:Name="TileInvertClip" Rect="0,0,0,0" />
                </Grid.Clip>

                <UniformGrid Rows="1" Columns="3">
                    <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="監視" FontFamily="Yu Gothic UI" FontSize="20"
                                   Foreground="{DynamicResource Paper}" />
                        <TextBlock Text="{Binding [tile.monitor], Source={x:Static app:Loc.Instance}}" FontSize="11"
                                   Margin="10,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Paper}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="時刻" FontFamily="Yu Gothic UI" FontSize="20"
                                   Foreground="{DynamicResource Paper}" />
                        <TextBlock Text="{Binding [tile.clock], Source={x:Static app:Loc.Instance}}" FontSize="11"
                                   Margin="10,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Paper}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="16,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="画像" FontFamily="Yu Gothic UI" FontSize="20"
                                   Foreground="{DynamicResource Paper}" />
                        <TextBlock Text="{Binding [tile.media], Source={x:Static app:Loc.Instance}}" FontSize="11"
                                   Margin="10,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Paper}" />
                    </StackPanel>


                </UniformGrid>
            </Grid>

            <!-- Светлые подписи и клик: всё, что остаётся вне стекла -->
            <UniformGrid x:Name="TileLabelLayer" Rows="1" Columns="3">
                <UniformGrid.Clip>
                    <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1>
                            <RectangleGeometry Rect="-10000,-10000,20000,20000" />
                        </CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                            <RectangleGeometry x:Name="TileHoleRect" Rect="0,0,0,0" />
                        </CombinedGeometry.Geometry2>
                    </CombinedGeometry>
                </UniformGrid.Clip>

                <ToggleButton x:Name="TileMonitor" Style="{StaticResource Tile}" Tag="Monitor"
                              Margin="0,0,10,0" Click="OnThemeTileClick" IsChecked="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="監視" FontFamily="Yu Gothic UI" FontSize="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock Text="{Binding [tile.monitor], Source={x:Static app:Loc.Instance}}" FontSize="11"
                                   Margin="10,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="TileClock" Style="{StaticResource Tile}" Tag="Clock"
                              Margin="0,0,10,0" Click="OnThemeTileClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="時刻" FontFamily="Yu Gothic UI" FontSize="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock Text="{Binding [tile.clock], Source={x:Static app:Loc.Instance}}" FontSize="11"
                                   Margin="10,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton x:Name="TileMedia" Style="{StaticResource Tile}" Tag="Media"
                              Margin="0,0,10,0" Click="OnThemeTileClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="画像" FontFamily="Yu Gothic UI" FontSize="20"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        <TextBlock Text="{Binding [tile.media], Source={x:Static app:Loc.Instance}}" FontSize="11"
                                   Margin="10,0,0,3" VerticalAlignment="Bottom"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                    </StackPanel>
                </ToggleButton>
            </UniformGrid>
        </Grid>

        <!-- Контент: настройки/темы слева, превью справа -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="452" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Фон: картинка в цвет темы окна (assets/backdrop.jpg) -->
            <Rectangle Grid.Column="0" Fill="{DynamicResource Phantom}" Opacity="0.14"
                       IsHitTestVisible="False" Margin="0,0,12,0">
                <Rectangle.OpacityMask>
                    <ImageBrush x:Name="BackdropMask" Stretch="UniformToFill"
                                AlignmentX="Right" AlignmentY="Center" />
                </Rectangle.OpacityMask>
            </Rectangle>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" Padding="0,0,12,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}" />
                </ScrollViewer.Resources>

                <Grid>
                    <!-- Вкладка «Настройки» -->
                    <StackPanel x:Name="SettingsPanel">

                        <TextBlock x:Name="SectionTheme"
                                   Text="{Binding [section.theme], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Section}" />

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PaletteLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowPaletteLabel"
                                       Text="{Binding [theme.palette], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <controls:LiquidSegments x:Name="PaletteSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="4">
                                    <ToggleButton x:Name="PaletteCream" Style="{StaticResource Seg}" Tag="cream"
                                                  Click="OnPaletteClick"
                                                  Content="{Binding [palette.cream], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="PaletteOcean" Style="{StaticResource Seg}" Tag="ocean"
                                                  Margin="6,0,0,0" Click="OnPaletteClick"
                                                  Content="{Binding [palette.ocean], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="PaletteSakura" Style="{StaticResource Seg}" Tag="sakura"
                                                  Margin="6,0,0,0" Click="OnPaletteClick"
                                                  Content="{Binding [palette.sakura], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="PaletteForest" Style="{StaticResource Seg}" Tag="forest"
                                                  Margin="6,0,0,0" Click="OnPaletteClick"
                                                  Content="{Binding [palette.forest], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="WindowLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowWindowLabel"
                                       Text="{Binding [theme.window], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <controls:LiquidSegments x:Name="SkinSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="SkinLight" Style="{StaticResource Seg}" Tag="light"
                                                  Click="OnSkinClick"
                                                  Content="{Binding [theme.light], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="SkinDark" Style="{StaticResource Seg}" Tag="dark"
                                                  Margin="6,0,0,0" Click="OnSkinClick"
                                                  Content="{Binding [theme.dark], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                        <Grid x:Name="PanelRow" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PanelLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowPanelLabel"
                                       Text="{Binding [theme.panel], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <controls:LiquidSegments x:Name="PanelSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="PanelLight" Style="{StaticResource Seg}" Tag="light"
                                                  Click="OnPanelClick"
                                                  Content="{Binding [theme.light], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="PanelDark" Style="{StaticResource Seg}" Tag="dark"
                                                  Margin="6,0,0,0" Click="OnPanelClick"
                                                  Content="{Binding [theme.dark], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                        <!-- Вид темы «Монитор»: обычный, минимал, график, кольца и ещё десять -->
                        <Grid x:Name="ViewRow" Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ViewLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowViewLabel"
                                       Text="{Binding [section.view], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}"
                                       VerticalAlignment="Top" Margin="0,9,0,0" />
                            <controls:LiquidSegments x:Name="ViewSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="4">
                                    <ToggleButton x:Name="ViewFull" Style="{StaticResource Seg}" Tag="Monitor"
                                                  Margin="0,0,5,5" Click="OnViewClick"
                                                  Content="{Binding [view.full], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewMinimal" Style="{StaticResource Seg}" Tag="Minimal"
                                                  Margin="0,0,5,5" Click="OnViewClick"
                                                  Content="{Binding [view.minimal], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewHistory" Style="{StaticResource Seg}" Tag="History"
                                                  Margin="0,0,5,5" Click="OnViewClick"
                                                  Content="{Binding [view.history], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewRings" Style="{StaticResource Seg}" Tag="Rings"
                                                  Margin="0,0,0,5" Click="OnViewClick"
                                                  Content="{Binding [view.rings], Source={x:Static app:Loc.Instance}}" />

                                    <ToggleButton x:Name="ViewBars" Style="{StaticResource Seg}" Tag="Bars"
                                                  Margin="0,0,5,5" Click="OnViewClick"
                                                  Content="{Binding [view.bars], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewDial" Style="{StaticResource Seg}" Tag="Dial"
                                                  Margin="0,0,5,5" Click="OnViewClick"
                                                  Content="{Binding [view.dial], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewType" Style="{StaticResource Seg}" Tag="Typographic"
                                                  Margin="0,0,5,5" Click="OnViewClick"
                                                  Content="{Binding [view.typo], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewCells" Style="{StaticResource Seg}" Tag="Cells"
                                                  Margin="0,0,0,5" Click="OnViewClick"
                                                  Content="{Binding [view.cells], Source={x:Static app:Loc.Instance}}" />

                                    <ToggleButton x:Name="ViewList" Style="{StaticResource Seg}" Tag="List"
                                                  Margin="0,0,5,0" Click="OnViewClick"
                                                  Content="{Binding [view.list], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewWave" Style="{StaticResource Seg}" Tag="Wave"
                                                  Margin="0,0,5,0" Click="OnViewClick"
                                                  Content="{Binding [view.wave], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewSplit" Style="{StaticResource Seg}" Tag="Split"
                                                  Margin="0,0,5,0" Click="OnViewClick"
                                                  Content="{Binding [view.split], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="ViewCustom" Style="{StaticResource Seg}" Tag="Custom"
                                                  Margin="0" Click="OnViewClick"
                                                  Content="{Binding [view.custom], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,16,0,14" />

                        <!-- Своё: акцент кадра и собственная подпись -->
                        <TextBlock x:Name="SectionCustom"
                                   Text="{Binding [section.custom], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Section}" />

                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AccentLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowAccentLabel"
                                       Text="{Binding [custom.accent], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="AccentInk" Style="{StaticResource AccentDot}"
                                              Background="#101012" Tag="#101012" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.ink], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentRose" Style="{StaticResource AccentDot}"
                                              Background="#D98F96" Tag="#D98F96" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.rose], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentOcean" Style="{StaticResource AccentDot}"
                                              Background="#4C9BC4" Tag="#4C9BC4" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.ocean], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentForest" Style="{StaticResource AccentDot}"
                                              Background="#4F8A5F" Tag="#4F8A5F" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.forest], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentAmber" Style="{StaticResource AccentDot}"
                                              Background="#C98A3C" Tag="#C98A3C" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.amber], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentViolet" Style="{StaticResource AccentDot}"
                                              Background="#8E7CC3" Tag="#8E7CC3" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.violet], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentCoral" Style="{StaticResource AccentDot}"
                                              Background="#E06B5E" Tag="#E06B5E" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.coral], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="AccentMint" Style="{StaticResource AccentDot}"
                                              Background="#4FBFA0" Tag="#4FBFA0" Margin="0" Click="OnAccentClick"
                                              ToolTip="{Binding [accent.mint], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="CaptionLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowCaptionLabel"
                                       Text="{Binding [custom.caption], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <TextBox x:Name="CaptionBox" Grid.Column="1" Style="{StaticResource Field}"
                                     TextChanged="OnCaptionChanged"
                                     ToolTip="{Binding [custom.caption.hint], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LayoutLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowLayoutLabel"
                                       Text="{Binding [custom.layout], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AddWidgetButton" Style="{StaticResource Ghost}"
                                        Click="OnAddWidgetClick"
                                        Content="{Binding [custom.add], Source={x:Static app:Loc.Instance}}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Tag="cpu" Click="OnAddWidgetType"
                                                      Header="{Binding [widget.cpu], Source={x:Static app:Loc.Instance}}" />
                                            <MenuItem Tag="ram" Click="OnAddWidgetType"
                                                      Header="{Binding [widget.ram], Source={x:Static app:Loc.Instance}}" />
                                            <MenuItem Tag="gpu" Click="OnAddWidgetType"
                                                      Header="{Binding [widget.gpu], Source={x:Static app:Loc.Instance}}" />
                                            <MenuItem Tag="uptime" Click="OnAddWidgetType"
                                                      Header="{Binding [widget.uptime], Source={x:Static app:Loc.Instance}}" />
                                            <MenuItem Tag="clock" Click="OnAddWidgetType"
                                                      Header="{Binding [widget.clock], Source={x:Static app:Loc.Instance}}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="RemoveWidgetButton" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                        Click="OnRemoveWidgetClick" IsEnabled="False" Opacity="0.4"
                                        Content="{Binding [custom.remove], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Margin="0,7,0,0"
                                   Text="{Binding [custom.hint], Source={x:Static app:Loc.Instance}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FontLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowFontLabel"
                                       Text="{Binding [custom.font], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <ComboBox x:Name="FontPicker" Grid.Column="1" Style="{StaticResource FontPicker}"
                                      SelectionChanged="OnFontChanged" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="InkLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowInkLabel"
                                       Text="{Binding [custom.color], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="InkDefault" Style="{StaticResource AccentDot}"
                                              Background="#101012" Tag="" Click="OnInkClick"
                                              ToolTip="{Binding [ink.default], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="InkLight" Style="{StaticResource AccentDot}"
                                              Background="#FFFFFF" Tag="light" Click="OnInkClick"
                                              ToolTip="{Binding [ink.light], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="InkGrey" Style="{StaticResource AccentDot}"
                                              Background="#9AA0A6" Tag="grey" Click="OnInkClick"
                                              ToolTip="{Binding [ink.grey], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="InkAccentDot" Style="{StaticResource AccentDot}"
                                              Background="#D98F96" Tag="accent" Margin="0" Click="OnInkClick"
                                              ToolTip="{Binding [ink.accent], Source={x:Static app:Loc.Instance}}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BackgroundLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowBackgroundLabel"
                                       Text="{Binding [custom.background], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="BackgroundSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="20" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [custom.background], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnBackgroundChanged" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ScaleLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowScaleLabel"
                                       Text="{Binding [custom.scale], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="60" Maximum="160" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [custom.scale], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnScaleChanged" />
                            <Button x:Name="ResetViewButton" Grid.Column="2" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Click="OnResetViewClick"
                                    Content="{Binding [custom.reset], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,16,0,14" />

                        <TextBlock x:Name="SectionMedia" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MediaButton" Style="{StaticResource Ghost}"
                                    Click="OnPickClick" />
                            <!-- Кнопка сброса нужна только у фона: возвращает бумагу темы. -->
                            <Button x:Name="ResetBackdropButton" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="OnResetBackdropClick"
                                    Content="{Binding [media.reset], Source={x:Static app:Loc.Instance}}"
                                    ToolTip="{Binding [media.reset.tip], Source={x:Static app:Loc.Instance}}" />
                        </StackPanel>
                        <TextBlock x:Name="MediaText" Style="{StaticResource Hint}" Margin="0,7,0,0" />

                        <TextBlock x:Name="RecentLabel" Text="{Binding [recent.title], Source={x:Static app:Loc.Instance}}"
                                   FontSize="10" Foreground="{DynamicResource Grey}"
                                   Margin="0,14,0,6" Visibility="Collapsed" />
                        <Grid x:Name="RecentHost">
                            <UniformGrid x:Name="RecentGrid" Rows="1" Columns="4" Visibility="Collapsed" />
                            <Canvas x:Name="RecentGlassLayer" IsHitTestVisible="False" Panel.ZIndex="10">
                                <Border x:Name="RecentGlass" Width="0" Height="0" CornerRadius="8"
                                        Background="#55D98F96"
                                        BorderBrush="{DynamicResource Ink}" BorderThickness="2.5"
                                        Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                                          Opacity="0.35" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- Темп: подпись слева от ползунка, чтобы в свёрнутой панели было видно, что это FPS -->
                        <Grid x:Name="FpsBlock" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [section.fps], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="FpsSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [section.fps], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnFpsChanged" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [section.light], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="10" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [section.light], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnBrightnessChanged" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,16,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AutoLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowAutoStartLabel"
                                       Text="{Binding [startup.auto], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center"
                                       ToolTip="{Binding [startup.tip], Source={x:Static app:Loc.Instance}}" />
                            <controls:LiquidSegments x:Name="AutoSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="AutoOff" Style="{StaticResource Seg}" Tag="off"
                                                  Click="OnAutoStartClick"
                                                  Content="{Binding [startup.off], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="AutoOn" Style="{StaticResource Seg}" Tag="on"
                                                  Margin="6,0,0,0" Click="OnAutoStartClick"
                                                  Content="{Binding [startup.on], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AutoOutputLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowAutoOutputLabel"
                                       Text="{Binding [startup.autoOutput], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center"
                                       ToolTip="{Binding [startup.autoOutput.tip], Source={x:Static app:Loc.Instance}}" />
                            <controls:LiquidSegments x:Name="AutoOutputSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="AutoOutputOff" Style="{StaticResource Seg}" Tag="off"
                                                  Click="OnAutoOutputClick"
                                                  Content="{Binding [startup.off], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="AutoOutputOn" Style="{StaticResource Seg}" Tag="on"
                                                  Margin="6,0,0,0" Click="OnAutoOutputClick"
                                                  Content="{Binding [startup.on], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                    </StackPanel>

                    <!-- Вкладка «Темы» -->
                    <StackPanel x:Name="ThemesPanel" Visibility="Collapsed">

                        <TextBlock x:Name="SectionMyThemes"
                                   Text="{Binding [section.mythemes], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Section}" />
                        <TextBlock x:Name="ThemesHint"
                                   Text="{Binding [themes.hint], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Hint}" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PresetNameBox" Style="{StaticResource Field}"
                                     ToolTip="{Binding [themes.name], Source={x:Static app:Loc.Instance}}" />
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Click="OnSavePresetClick"
                                    Content="{Binding [themes.save], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <ListBox x:Name="PresetList" Height="380"
                                     Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                                     BorderThickness="1" ItemContainerStyle="{StaticResource PresetItem}"
                                     MouseDoubleClick="OnPresetDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Миниатюра — тот же кадр, что уходит на панель -->
                                            <Border Width="80" Height="60" CornerRadius="4"
                                                    Background="{DynamicResource Wash}"
                                                    BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                       SnapsToDevicePixels="True">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,80,60" RadiusX="3" RadiusY="3" />
                                                    </Image.Clip>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="9" Height="9" CornerRadius="4.5"
                                                            Background="{Binding AccentBrush}"
                                                            BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="8,0,0,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Margin="17,2,0,0"
                                                           Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="PresetEmpty" FontSize="11" Foreground="{DynamicResource Faint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="{Binding [themes.empty], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Ghost}" Click="OnApplyPresetClick"
                                    Content="{Binding [themes.apply], Source={x:Static app:Loc.Instance}}" />
                            <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnDeletePresetClick"
                                    Content="{Binding [themes.delete], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="{Binding [themes.dbl], Source={x:Static app:Loc.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Правая колонка: превью и вывод -->
            <Grid Grid.Column="1" Margin="24,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                        BorderThickness="1" CornerRadius="16" Padding="7">
                    <Border Background="{DynamicResource Wash}" CornerRadius="11">
                        <Viewbox Stretch="Uniform" Margin="1">
                            <Grid Width="320" Height="240">
                                <Image x:Name="Preview" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       MouseLeftButtonDown="OnPreviewMouseDown"
                                       MouseMove="OnPreviewMouseMove"
                                       MouseLeftButtonUp="OnPreviewMouseUp"
                                       MouseLeave="OnPreviewMouseLeave" />
                                <!-- Затемнение превью повторяет яркость панели -->
                                <Rectangle x:Name="PreviewDim" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                                <!-- Рамка выбранного объекта: только в окне, на панель не уходит -->
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="WidgetSelection" Visibility="Collapsed"
                                            BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                            CornerRadius="3" />
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Border>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ToggleButton" Style="{StaticResource Solid}" Width="230" Height="46"
                            Click="OnToggleClick" />

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Не подключено" FontSize="13"
                                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                        <TextBlock x:Name="InfoText" FontFamily="Consolas" FontSize="11"
                                   Foreground="{DynamicResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource Rule}" Margin="0,0,0,8" />
                    <TextBlock x:Name="LogText" FontSize="11" Foreground="{DynamicResource Grey}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [preview.hint], Source={x:Static app:Loc.Instance}}"
                               FontSize="9" Foreground="{DynamicResource Faint}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
