<Window x:Class="TrccSharp.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:TrccSharp.App"
        xmlns:controls="clr-namespace:TrccSharp.App.Controls"
        Title="TrccSharp — экран СЖО"
        Icon="assets/TrccSharp.ico"
        Height="880" Width="1180" MinHeight="700" MinWidth="1040"
        Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        AllowDrop="True" Drop="OnDropFile" DragOver="OnDragOver">

    <Window.Resources>
        <!-- Кисти Ink/Paper/Surface/Grey/Faint/Rule/Wash/Rose приходят из Skins.cs:
             светлая и тёмная темы окна переключаются на лету. -->

        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Три полоски: сворачивают подписи левой панели до одних контролов -->
        <Style x:Key="Burger" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Rule}" BorderThickness="1" CornerRadius="11">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border x:Name="L1" Width="14" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Ink}" Margin="0,0,0,3" />
                                <Border x:Name="L2" Width="14" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Ink}" Margin="0,0,0,3" />
                                <Border x:Name="L3" Width="14" Height="2" CornerRadius="1"
                                        Background="{DynamicResource Ink}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rose}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                <Setter TargetName="L1" Property="Background" Value="{DynamicResource Paper}" />
                                <Setter TargetName="L2" Property="Background" Value="{DynamicResource Paper}" />
                                <Setter TargetName="L3" Property="Background" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ползунок: мягкая дорожка и круглая ручка -->
        <Style x:Key="InkSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Rule}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Rose}" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource Ink}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка темы панели: сама плитка прозрачная — заливку рисует
             переезжающее «жидкое стекло», а текст всегда остаётся сверху. -->
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Height" Value="60" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="14" Opacity="0"
                                    Background="{DynamicResource Wash}"
                                    BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                    IsHitTestVisible="False" />
                            <ContentPresenter Margin="16,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.55" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Подложка плитки: карточка, поверх которой ездит стекло -->
        <Style x:Key="TileShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <!-- Вкладка в шапке: пилюля -->
        <Style x:Key="Tab" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="12,0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Язык: маленькая пилюля -->
        <Style x:Key="Lang" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Grey}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель из двух вариантов: заливку рисует LiquidSegments -->
        <Style x:Key="Seg" TargetType="ToggleButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="9" Opacity="0"
                                    Background="{DynamicResource Wash}"
                                    BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                    IsHitTestVisible="False" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Hover" Property="Opacity" Value="0.5" />
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кружок акцента: цвет внутри, кольцо вокруг, выбор — жирное кольцо -->
        <Style x:Key="AccentDot" TargetType="ToggleButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Rule}" StrokeThickness="1" />
                            <Ellipse x:Name="Dot" Margin="4" Fill="{TemplateBinding Background}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Rose}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ink}" />
                                <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Выбор шрифта кадра -->
        <Style x:Key="FontPicker" TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                BorderThickness="1" CornerRadius="9">
                                            <Grid>
                                                <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,10,0" Data="M 0 0 L 8 0 L 4 5 Z"
                                                      Fill="{DynamicResource Grey}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                                        BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" MaxHeight="260"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                        <EventSetter Event="MouseEnter" Handler="OnFontItemHover" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Row" Background="Transparent" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Wash}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>

            <!-- Имя шрифта набрано им самим: список сразу показывает, как будет выглядеть -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13"
                                   Foreground="{DynamicResource Ink}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт выпадающего меню -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка-контур -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rose}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка -->
        <Style x:Key="Solid" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Paper}" />
            <Setter Property="Background" Value="{DynamicResource Ink}" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле ввода -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Rule}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" CornerRadius="9"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Rose}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкая полоса прокрутки -->
        <Style x:Key="ThinScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="5">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource Faint}" CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Строка списка тем -->
        <Style x:Key="PresetItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Box" Background="Transparent" CornerRadius="9" Margin="2" Padding="9,7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Wash}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ink}" />
                                <Setter Property="Foreground" Value="{DynamicResource Paper}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка: три полоски, название, вкладки, язык -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton x:Name="CompactToggle" Style="{StaticResource Burger}" Click="OnCompactClick" />
                <TextBlock Text="TrccSharp" FontFamily="Segoe UI Variable Display Light, Segoe UI Light" FontSize="30" Margin="14,0,0,0"
                           Foreground="{DynamicResource Ink}" />
                <TextBlock Text="画面" FontFamily="Yu Gothic UI" FontSize="15"
                           Foreground="{DynamicResource Rose}" Margin="12,0,0,5" VerticalAlignment="Bottom" />
            </StackPanel>

            <controls:LiquidSegments x:Name="TabSegments" Grid.Column="1" VerticalAlignment="Bottom"
                                     Margin="28,0,0,2"
                                     PillBrush="{DynamicResource Wash}" PillCornerRadius="9">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="TabSettings" Style="{StaticResource Tab}" IsChecked="True"
                                  Tag="settings" Click="OnTabClick"
                                  Content="{Binding [tab.main], Source={x:Static app:Loc.Instance}}" />
                    <ToggleButton x:Name="TabPresets" Style="{StaticResource Tab}" Tag="presets"
                                  Margin="4,0,0,0" Click="OnTabClick"
                                  Content="{Binding [tab.themes], Source={x:Static app:Loc.Instance}}" />
                    <ToggleButton x:Name="TabStartup" Style="{StaticResource Tab}" Tag="startup"
                                  Margin="4,0,0,0" Click="OnTabClick"
                                  Content="{Binding [tab.settings], Source={x:Static app:Loc.Instance}}" />
                </StackPanel>
            </controls:LiquidSegments>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ThemeModeButton" Width="28" Height="28" Margin="0,0,8,0" Click="OnThemeModeClick"
                        Cursor="Hand" ToolTip="{Binding [theme.toggle], Source={x:Static app:Loc.Instance}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Ring" CornerRadius="14" BorderThickness="1"
                                        BorderBrush="{DynamicResource Rule}" />
                                <Ellipse Margin="4">
                                    <Ellipse.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FFFFFF" Offset="0.5" />
                                            <GradientStop Color="#101012" Offset="0.5" />
                                        </LinearGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Rose}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="PaletteButton" Width="28" Height="28" Margin="0,0,10,0" Click="OnThemePaletteClick"
                        Cursor="Hand" ToolTip="{Binding [theme.palette], Source={x:Static app:Loc.Instance}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Ring" CornerRadius="14" BorderThickness="1"
                                        BorderBrush="{DynamicResource Rule}" />
                                <!-- Палитра: значок вместо радужного круга -->
                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Ink}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Rose}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <controls:LiquidSegments x:Name="LangSegments"
                                         PillBrush="{DynamicResource Ink}" PillCornerRadius="7">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LangRu" Style="{StaticResource Lang}" Content="RU" Tag="ru"
                                      Click="OnLangClick" />
                        <ToggleButton x:Name="LangEn" Style="{StaticResource Lang}" Content="EN" Tag="en"
                                      Margin="4,0,0,0" Click="OnLangClick" />
                    </StackPanel>
                </controls:LiquidSegments>
                <TextBlock Text="{Binding [header.screen], Source={x:Static app:Loc.Instance}}"
                           Width="180" TextAlignment="Right"
                           FontSize="10" Foreground="{DynamicResource Grey}"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Popup x:Name="ThemePalettePopup" PlacementTarget="{Binding ElementName=PaletteButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                    BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,8,0,0" Width="180">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                      Opacity="0.35" Color="#000000" />
                </Border.Effect>
                        <controls:LiquidSegments x:Name="PaletteSegments" PillBrush="{DynamicResource Ink}"
                                                 PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                            <UniformGrid Columns="1">
                                <ToggleButton x:Name="PaletteCream" Style="{StaticResource Seg}" Tag="cream"
                                              Margin="0,0,0,6" Click="OnPaletteClick"
                                              Content="{Binding [palette.cream], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="PaletteOcean" Style="{StaticResource Seg}" Tag="ocean"
                                              Margin="0,0,0,6" Click="OnPaletteClick"
                                              Content="{Binding [palette.ocean], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="PaletteSakura" Style="{StaticResource Seg}" Tag="sakura"
                                              Margin="0,0,0,6" Click="OnPaletteClick"
                                              Content="{Binding [palette.sakura], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="PaletteForest" Style="{StaticResource Seg}" Tag="forest"
                                              Click="OnPaletteClick"
                                              Content="{Binding [palette.forest], Source={x:Static app:Loc.Instance}}" />
                            </UniformGrid>
                        </controls:LiquidSegments>
            </Border>
        </Popup>
        <!-- Меню добавления объектов -->
        <Popup x:Name="AddMenuPopup" Placement="Center" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                    BorderThickness="1" CornerRadius="14" Padding="8" Width="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270"
                                      Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Canvas x:Name="AddMenuGlassLayer" IsHitTestVisible="False" ClipToBounds="False">
                        <!-- Жидкое стекло: переезжает к пункту под курсором и слегка вытягивается -->
                        <Border x:Name="AddMenuGlass" CornerRadius="8" Visibility="Collapsed"
                                BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="AddMenuGlassScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#4DFFFFFF" Offset="0" />
                                    <GradientStop Color="#26FFFFFF" Offset="0.45" />
                                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <!-- Блик по верхней кромке — читается как стекло -->
                            <Border Height="1" VerticalAlignment="Top" Margin="7,0,7,0"
                                    CornerRadius="1" Background="#8CFFFFFF" />
                            <Border.Effect>
                                <DropShadowEffect x:Name="AddMenuGlassGlow" BlurRadius="14" ShadowDepth="0"
                                                  Opacity="0.45" Color="#FFD98F96" />
                            </Border.Effect>
                        </Border>
                    </Canvas>
                <StackPanel x:Name="AddMenuList" MouseLeave="OnAddMenuLeave">
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="cpu" Click="OnAddWidgetType"
                            Content="{Binding [widget.cpu], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="ring" Click="OnAddWidgetType"
                            Content="{Binding [widget.ring], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="ram" Click="OnAddWidgetType"
                            Content="{Binding [widget.ram], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="ramfull" Click="OnAddWidgetType"
                            Content="{Binding [widget.ramfull], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="gpu" Click="OnAddWidgetType"
                            Content="{Binding [widget.gpu], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="cputemp" Click="OnAddWidgetType"
                            Content="{Binding [widget.cputemp], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="gpuload" Click="OnAddWidgetType"
                            Content="{Binding [widget.gpuload], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="uptime" Click="OnAddWidgetType"
                            Content="{Binding [widget.uptime], Source={x:Static app:Loc.Instance}}" />
                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="clock" Click="OnAddWidgetType"
                            Content="{Binding [widget.clock], Source={x:Static app:Loc.Instance}}" />

                    <Border Height="1" Background="{DynamicResource Rule}" Margin="6,4" />

                    <Button Style="{StaticResource MenuButton}" MouseEnter="OnAddMenuHover" Tag="text" Click="OnAddWidgetType"
                            Content="{Binding [widget.text], Source={x:Static app:Loc.Instance}}" />
                </StackPanel>
                </Grid>
            </Border>
        </Popup>
        <!-- Своя палитра: квадрат «насыщенность × яркость» и линейка оттенков -->
                                        <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=InkCustomDot}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                                                    BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,8,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                                                                      Opacity="0.35" Color="#000000" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
        
                                                    <Canvas x:Name="ColorSquare" Width="200" Height="140" ClipToBounds="True"
                                                            Background="Transparent"
                                                            MouseLeftButtonDown="OnColorSquareDown"
                                                            MouseMove="OnColorSquareMove"
                                                            MouseLeftButtonUp="OnColorSquareUp">
                                                        <Rectangle x:Name="ColorHueBase" Width="200" Height="140" />
                                                        <Rectangle Width="200" Height="140">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#00000000" Offset="0" />
                                                                    <GradientStop Color="#FF000000" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Ellipse x:Name="ColorCursor" Width="12" Height="12"
                                                                 Stroke="White" StrokeThickness="2" IsHitTestVisible="False" />
                                                    </Canvas>
        
                                                    <Canvas x:Name="HueStrip" Grid.Column="1" Width="28" Height="140"
                                                            Margin="10,0,0,0" ClipToBounds="True" Background="Transparent"
                                                            MouseLeftButtonDown="OnHueDown"
                                                            MouseMove="OnHueMove"
                                                            MouseLeftButtonUp="OnHueUp">
                                                        <Rectangle Width="28" Height="140">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#FF0000" Offset="0" />
                                                                    <GradientStop Color="#FFFF00" Offset="0.1667" />
                                                                    <GradientStop Color="#00FF00" Offset="0.3333" />
                                                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                                                    <GradientStop Color="#0000FF" Offset="0.6667" />
                                                                    <GradientStop Color="#FF00FF" Offset="0.8333" />
                                                                    <GradientStop Color="#FF0000" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
        
                                                        <Border x:Name="HueCursor" Height="4" Width="28" Background="White"
                                                                IsHitTestVisible="False" />
                                                    </Canvas>
        
                                                    <StackPanel Grid.Column="2" Width="34" Margin="10,0,0,0">
                                                        <Border Height="140" CornerRadius="6" BorderThickness="1"
                                                                BorderBrush="{DynamicResource Rule}">
                                                            <Rectangle x:Name="ColorPreview" />
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Popup>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource Rule}" Margin="0,0,0,14" />

        <!-- Плитки тем панели. Слои снизу вверх: карточки → стекло → подписи →
             кликабельные плитки. Подписи идут в двух цветах: светлые видны вне
             стекла, тёмные — ровно под ним, поэтому надпись читается всегда,
             даже когда стекло проезжает над ней. -->
        <!-- Кнопка добавления объектов: белая, по краям — цвет темы -->
        <Button x:Name="AddObjectButton" Grid.Row="2" Height="60" Margin="0,0,0,16"
                Click="OnAddWidgetClick" Cursor="Hand" ToolTip="{Binding [custom.hint], Source={x:Static app:Loc.Instance}}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell" CornerRadius="14" Background="#FFFFFF"
                            BorderBrush="{DynamicResource Rose}" BorderThickness="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="+" FontSize="22" Foreground="#2B2733" VerticalAlignment="Center" />
                <TextBlock Text="{Binding [custom.addObject], Source={x:Static app:Loc.Instance}}"
                           FontFamily="Segoe UI Variable Display Light, Segoe UI Light" FontSize="20" Foreground="#2B2733"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

        </Button>
        <!-- Контент: настройки/темы слева, превью справа -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="452" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Фон: картинка в цвет темы окна (assets/backdrop.jpg) -->
            <Rectangle Grid.Column="0" Fill="{DynamicResource Phantom}" Opacity="0.14"
                       IsHitTestVisible="False" Margin="0,0,12,0">
                <Rectangle.OpacityMask>
                    <ImageBrush x:Name="BackdropMask" Stretch="UniformToFill"
                                AlignmentX="Right" AlignmentY="Center" />
                </Rectangle.OpacityMask>
            </Rectangle>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Hidden" Padding="0,0,12,0">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}" />
                </ScrollViewer.Resources>

                <Grid>
                    <!-- Вкладка «Настройки» -->
                    <StackPanel x:Name="SettingsPanel">

                        <TextBlock x:Name="SectionCustom"
                                   Text="{Binding [section.custom], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Section}" />

                        <Grid x:Name="LabelRow" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LabelCaptionColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowLabelCaption"
                                       Text="{Binding [custom.label], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <TextBox x:Name="WidgetLabelBox" Grid.Column="1" Style="{StaticResource Field}"
                                     TextChanged="OnWidgetLabelChanged"
                                     ToolTip="{Binding [custom.label.tip], Source={x:Static app:Loc.Instance}}" />
                        </Grid>
                        <Grid x:Name="LabelAlignRow" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="LabelAlignCaptionColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowLabelAlign"
                                       Text="{Binding [custom.align], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <controls:LiquidSegments x:Name="LabelAlignSegments" Grid.Column="1"
                                                     HorizontalAlignment="Left"
                                                     PillBrush="{DynamicResource Wash}" PillCornerRadius="9">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="LabelAlignLeft" Style="{StaticResource Tab}" IsChecked="True"
                                                  Tag="left" Click="OnLabelAlignClick"
                                                  Content="{Binding [custom.align.left], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="LabelAlignCenter" Style="{StaticResource Tab}" Tag="center"
                                                  Margin="4,0,0,0" Click="OnLabelAlignClick"
                                                  Content="{Binding [custom.align.center], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="LabelAlignRight" Style="{StaticResource Tab}" Tag="right"
                                                  Margin="4,0,0,0" Click="OnLabelAlignClick"
                                                  Content="{Binding [custom.align.right], Source={x:Static app:Loc.Instance}}" />
                                </StackPanel>
                            </controls:LiquidSegments>
                        </Grid>
                        <Grid x:Name="TextRow" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TextLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowTextLabel"
                                       Text="{Binding [custom.textValue], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <TextBox x:Name="WidgetTextBox" Grid.Column="1" Style="{StaticResource Field}"
                                     TextChanged="OnWidgetTextChanged"
                                     ToolTip="{Binding [custom.textValue.tip], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="FontLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowFontLabel"
                                       Text="{Binding [custom.font], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <ComboBox x:Name="FontPicker" Grid.Column="1" Style="{StaticResource FontPicker}"
                                      SelectionChanged="OnFontChanged"
                                      DropDownClosed="OnFontDropDownClosed" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="InkLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowInkLabel"
                                       Text="{Binding [custom.color], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="InkDefault" Style="{StaticResource AccentDot}"
                                              Background="#101012" Tag="" Click="OnInkClick"
                                              ToolTip="{Binding [ink.default], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="InkGrey" Style="{StaticResource AccentDot}"
                                              Background="#9AA0A6" Tag="grey" Click="OnInkClick"
                                              ToolTip="{Binding [ink.grey], Source={x:Static app:Loc.Instance}}" />
                                <ToggleButton x:Name="InkAccentDot" Style="{StaticResource AccentDot}"
                                              Background="#D98F96" Tag="accent" Click="OnInkClick"
                                              ToolTip="{Binding [ink.accent], Source={x:Static app:Loc.Instance}}" />

                                <ToggleButton x:Name="InkCustomDot" Style="{StaticResource AccentDot}"
                                              Margin="0" Click="OnInkPick"
                                              ToolTip="{Binding [ink.custom], Source={x:Static app:Loc.Instance}}">
                                    <ToggleButton.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#E0576B" Offset="0" />
                                            <GradientStop Color="#E0B552" Offset="0.2" />
                                            <GradientStop Color="#69C46B" Offset="0.4" />
                                            <GradientStop Color="#4FB3D9" Offset="0.6" />
                                            <GradientStop Color="#8A6FD6" Offset="0.8" />
                                            <GradientStop Color="#D96FB4" Offset="1" />
                                        </LinearGradientBrush>
                                    </ToggleButton.Background>
                                </ToggleButton>
                                

                                
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="BackgroundLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowBackgroundLabel"
                                       Text="{Binding [custom.background], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="BackgroundSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="20" Maximum="100" Value="50" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [custom.background], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnBackgroundChanged" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="TextBrightnessLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowTextBrightnessLabel"
                                       Text="{Binding [custom.text], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="TextBrightnessSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="50" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [custom.text], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnTextBrightnessChanged" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ScaleLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowScaleLabel"
                                       Text="{Binding [custom.scale], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="ScaleSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="50" Maximum="300" Value="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [custom.scale], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnScaleChanged" />
                            <Button x:Name="ResetViewButton" Grid.Column="2" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Click="OnResetViewClick"
                                    ToolTip="{Binding [custom.reset.tip], Source={x:Static app:Loc.Instance}}"
                                    Content="{Binding [custom.reset], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <Button x:Name="RestoreDefaultsButton" Style="{StaticResource Ghost}" Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Click="OnRestoreDefaultsClick"
                                Content="{Binding [custom.restore], Source={x:Static app:Loc.Instance}}" />

                        <Border Height="1" Background="{DynamicResource Rule}" Margin="0,16,0,14" />

                        <TextBlock x:Name="SectionMedia" Style="{StaticResource Section}" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="MediaButton" Style="{StaticResource Ghost}"
                                    Click="OnPickClick" />
                            <!-- Кнопка сброса нужна только у фона: возвращает бумагу темы. -->
                            <Button x:Name="ResetBackdropButton" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Visibility="Collapsed" Click="OnResetBackdropClick"
                                    Content="{Binding [media.reset], Source={x:Static app:Loc.Instance}}"
                                    ToolTip="{Binding [media.reset.tip], Source={x:Static app:Loc.Instance}}" />
                        </StackPanel>
                        <TextBlock x:Name="MediaText" Style="{StaticResource Hint}" Margin="0,7,0,0" />

                        <TextBlock x:Name="RecentLabel" Text="{Binding [recent.title], Source={x:Static app:Loc.Instance}}"
                                   FontSize="10" Foreground="{DynamicResource Grey}"
                                   Margin="0,14,0,6" Visibility="Collapsed" />
                        <Grid x:Name="RecentHost">
                            <UniformGrid x:Name="RecentGrid" Rows="1" Columns="4" Visibility="Collapsed" />
                            <Canvas x:Name="RecentGlassLayer" IsHitTestVisible="False" Panel.ZIndex="10">
                                <Border x:Name="RecentGlass" Width="0" Height="0" CornerRadius="8"
                                        Background="#55D98F96"
                                        BorderBrush="{DynamicResource Ink}" BorderThickness="2.5"
                                        Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                                          Opacity="0.35" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                            </Canvas>
                        </Grid>

                        <!-- Темп: подпись слева от ползунка, чтобы в свёрнутой панели было видно, что это FPS -->
                        <Grid x:Name="FpsBlock" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [section.fps], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="FpsSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="1" Maximum="30" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [section.fps], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnFpsChanged" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [section.light], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center" />
                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Style="{StaticResource InkSlider}"
                                    Minimum="10" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ToolTip="{Binding [section.light], Source={x:Static app:Loc.Instance}}"
                                    ValueChanged="OnBrightnessChanged" />
                        </Grid>

                    </StackPanel>

                    <!-- Вкладка «Темы» -->
                    <StackPanel x:Name="StartupPanel" Visibility="Collapsed">

                                                <TextBlock x:Name="SectionStartup"
                                   Text="{Binding [section.startup], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Section}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AutoLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowAutoStartLabel"
                                       Text="{Binding [startup.auto], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center"
                                       ToolTip="{Binding [startup.tip], Source={x:Static app:Loc.Instance}}" />
                            <controls:LiquidSegments x:Name="AutoSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="AutoOff" Style="{StaticResource Seg}" Tag="off"
                                                  Click="OnAutoStartClick"
                                                  Content="{Binding [startup.off], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="AutoOn" Style="{StaticResource Seg}" Tag="on"
                                                  Margin="6,0,0,0" Click="OnAutoStartClick"
                                                  Content="{Binding [startup.on], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AutoOutputLabelColumn" Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="RowAutoOutputLabel"
                                       Text="{Binding [startup.autoOutput], Source={x:Static app:Loc.Instance}}"
                                       FontSize="10" Foreground="{DynamicResource Grey}" VerticalAlignment="Center"
                                       ToolTip="{Binding [startup.autoOutput.tip], Source={x:Static app:Loc.Instance}}" />
                            <controls:LiquidSegments x:Name="AutoOutputSegments" Grid.Column="1"
                                                     PillBrush="{DynamicResource Ink}"
                                                     PillCornerRadius="9" ShowShells="True" ShellCornerRadius="9">
                                <UniformGrid Columns="2">
                                    <ToggleButton x:Name="AutoOutputOff" Style="{StaticResource Seg}" Tag="off"
                                                  Click="OnAutoOutputClick"
                                                  Content="{Binding [startup.off], Source={x:Static app:Loc.Instance}}" />
                                    <ToggleButton x:Name="AutoOutputOn" Style="{StaticResource Seg}" Tag="on"
                                                  Margin="6,0,0,0" Click="OnAutoOutputClick"
                                                  Content="{Binding [startup.on], Source={x:Static app:Loc.Instance}}" />
                                </UniformGrid>
                            </controls:LiquidSegments>
                        </Grid>


                                            </StackPanel>

                    <!-- Вкладка «Темы» -->
                    <StackPanel x:Name="PresetsPanel" Visibility="Collapsed">
                        <TextBlock x:Name="SectionMyThemes"
                                   Text="{Binding [section.mythemes], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Section}" />
                        <TextBlock x:Name="ThemesHint"
                                   Text="{Binding [themes.hint], Source={x:Static app:Loc.Instance}}"
                                   Style="{StaticResource Hint}" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PresetNameBox" Style="{StaticResource Field}"
                                     ToolTip="{Binding [themes.name], Source={x:Static app:Loc.Instance}}" />
                            <Button Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                                    Click="OnSavePresetClick"
                                    Content="{Binding [themes.save], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <ListBox x:Name="PresetList" Height="380"
                                     Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                                     BorderThickness="1" ItemContainerStyle="{StaticResource PresetItem}"
                                     MouseDoubleClick="OnPresetDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Миниатюра — тот же кадр, что уходит на панель -->
                                            <Border Width="80" Height="60" CornerRadius="4"
                                                    Background="{DynamicResource Wash}"
                                                    BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill"
                                                       SnapsToDevicePixels="True">
                                                    <Image.Clip>
                                                        <RectangleGeometry Rect="0,0,80,60" RadiusX="3" RadiusY="3" />
                                                    </Image.Clip>
                                                </Image>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="9" Height="9" CornerRadius="4.5"
                                                            Background="{Binding AccentBrush}"
                                                            BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                                                            VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Margin="8,0,0,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            
                    </StackPanel>
                                                <TextBlock Text="{Binding Summary}" FontSize="10" Margin="17,2,0,0"
                                                           Opacity="0.7" TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="PresetEmpty" FontSize="11" Foreground="{DynamicResource Faint}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Text="{Binding [themes.empty], Source={x:Static app:Loc.Instance}}" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Ghost}" Click="OnApplyPresetClick"
                                    Content="{Binding [themes.apply], Source={x:Static app:Loc.Instance}}" />
                            <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="OnDeletePresetClick"
                                    Content="{Binding [themes.delete], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="{Binding [themes.dbl], Source={x:Static app:Loc.Instance}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Правая колонка: превью и вывод -->
            <Grid Grid.Column="1" Margin="24,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Rule}"
                        BorderThickness="1" CornerRadius="16" Padding="7">
                    <Border Background="{DynamicResource Wash}" CornerRadius="11">
                        <Viewbox Stretch="Uniform" Margin="1">
                            <Grid Width="320" Height="240">
                                <Image x:Name="Preview" Stretch="Fill" Focusable="True"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       MouseLeftButtonDown="OnPreviewMouseDown"
                                       MouseMove="OnPreviewMouseMove"
                                       MouseLeftButtonUp="OnPreviewMouseUp"
                                       MouseLeave="OnPreviewMouseLeave" />
                                <!-- Сетка для перетаскивания: показывается, пока тащат объект -->
                                <Rectangle x:Name="GridOverlay" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <GeometryDrawing>
                                                    <GeometryDrawing.Pen>
                                                        <Pen Brush="#55D98F96" Thickness="0.5" />
                                                    </GeometryDrawing.Pen>
                                                    <GeometryDrawing.Geometry>
                                                        <GeometryGroup>
                                                            <LineGeometry StartPoint="8,0" EndPoint="8,8" />
                                                            <LineGeometry StartPoint="0,8" EndPoint="8,8" />
                                                        </GeometryGroup>
                                                    </GeometryDrawing.Geometry>
                                                </GeometryDrawing>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <!-- Затемнение превью повторяет яркость панели -->
                                <Rectangle x:Name="PreviewDim" Fill="Black" Opacity="0" IsHitTestVisible="False" />
                                <!-- Рамки выделения и рамка-обводка: только в окне, на панель не уходят -->
                                <Canvas x:Name="WidgetOverlay" IsHitTestVisible="False">
                                    <Border x:Name="MarqueeRect" Visibility="Collapsed"
                                            BorderBrush="{DynamicResource Rose}" BorderThickness="1"
                                            Background="#22D98F96" CornerRadius="2" />
                                </Canvas>
                            </Grid>
                        </Viewbox>
                    </Border>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ToggleButton" Style="{StaticResource Solid}" Width="230" Height="46"
                            Click="OnToggleClick" />

                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Text="Не подключено" FontSize="13"
                                   Foreground="{DynamicResource Ink}" TextWrapping="Wrap" />
                        <TextBlock x:Name="InfoText" FontSize="11"
                                   Foreground="{DynamicResource Grey}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Border Height="1" Background="{DynamicResource Rule}" Margin="0,0,0,8" />
                    <TextBlock x:Name="LogText" FontSize="11" Foreground="{DynamicResource Grey}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [preview.hint], Source={x:Static app:Loc.Instance}}"
                               FontSize="9" Foreground="{DynamicResource Faint}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
