<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TrccSharp.App</RootNamespace>
    <AssemblyName>TrccSharp</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\TrccSharp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrccSharp.Core\TrccSharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Температура ЦП и загрузка ГП читаются через WMI. -->
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Фон окна: картинка пользователя, из неё Backdrop.cs делает маску по яркости. -->
    <Resource Include="assets\backdrop.jpg" />
    <Resource Include="assets\TrccSharp.ico" />
  </ItemGroup>

</Project>
